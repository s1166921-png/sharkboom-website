            "required": true
          },
          {
            "key": "destination",
            "label": "目的地／目的仓",
            "required": true
          },
          {
            "key": "coverageEnd",
            "label": "期望保障终点",
            "type": "select",
            "required": true,
            "options": [
              "到港",
              "到仓",
              "上架",
              "全程",
              "尚未确定，需沟通"
            ]
          },
          {
            "key": "shipmentMode",
            "label": "投保方式",
            "type": "select",
            "options": [
              "单票投保",
              "月度预约统保",
              "大批量出货／咨询 API 对接",
