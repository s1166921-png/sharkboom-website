            "required": true,
            "placeholder": "请填写营业执照上的公司全称"
          },
          {
            "key": "companyEnglish",
            "label": "公司英文名称",
            "placeholder": "如有，请按企业正式资料填写"
          },
          {
            "key": "contactName",
            "label": "联系人",
            "required": true
          },
          {
            "key": "phone",
            "label": "联系电话",
            "type": "tel",
