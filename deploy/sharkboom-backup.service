[Unit]
Description=Back up SharkBoom encrypted orders
[Service]
Type=oneshot
User=sharkboom
Group=sharkboom
WorkingDirectory=/opt/sharkboom-orders/current
ExecStart=/usr/bin/node server/backup.mjs
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sharkboom
